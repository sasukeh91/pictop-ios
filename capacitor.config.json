{
  "appId": "ro.pictop.app",
  "appName": "Handy-Man",
  "webDir": "www",
  "server": {
    "url": "https://handyman.pictop.ro",
    "cleartext": false,
    "allowNavigation": ["handyman.pictop.ro"]
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#1e3a8a",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#FF8F1F",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#1e3a8a"
    }
  }
}
